# Customer Support Chatbot — Environment Variables
# This project uses AWS IAM credentials for authentication.
# Configure AWS CLI first: aws configure
#
# The AgentCore Gateway URL is set directly in src/create_harness.py
# and src/chat.py after running src/setup_gateway.py

# AWS Region (must match where AgentCore resources are deployed)
AWS_REGION=us-east-1

# Note: GATEWAY_URL is obtained after running src/setup_gateway.py
# and should be configured in the Python scripts — do not commit it.
