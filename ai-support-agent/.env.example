# ─────────────────────────────────────────────────────────────────────────────
# AI Support Agent — Environment Variables
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real resource IDs or URLs.
# ─────────────────────────────────────────────────────────────────────────────

# AWS region
AWS_REGION=us-east-1

# AgentCore Gateway URL
# Format: https://<alias>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
GATEWAY_URL=

# Bedrock Knowledge Base ID (10-character alphanumeric string from the KB console)
KB_ID=

# AgentCore Memory ID (shown in the AgentCore Memory console)
MEMORY_ID=
