# Linda Afya Health Assistant — environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# OpenRouter API key — get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# For Streamlit Cloud deployment, add this key under:
# App settings → Secrets → paste as TOML:
# OPENROUTER_API_KEY = "your-openrouter-api-key-here"
